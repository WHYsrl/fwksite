<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Accesso · Frameworks Backoffice</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@300..800&family=Geist+Mono:wght@400;500&display=swap"><link rel="stylesheet" href="/public/css/admin.css?v=<%= typeof v !== "undefined" ? v : "1" %>"></head>
<body class="login">
<form method="post" action="/admin/login" class="card login-card">
  <div class="ab-logo"><span class="sq"></span>frame<em>works</em> <small>backoffice</small></div>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <label>Utente <input name="user" autocomplete="username" required autofocus></label>
  <label>Password <input name="password" type="password" autocomplete="current-password" required></label>
  <input type="hidden" name="next" value="<%= next %>">
  <button class="btn primary" type="submit">Entra</button>
</form>
</body></html>
