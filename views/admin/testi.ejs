<%- include('../partials/admin-head', { title: 'Testi' }) %>
<h1>Testi del sito</h1>
<p class="muted">Nei titoli puoi usare <code>&lt;em&gt;parola&lt;/em&gt;</code> per la parola in corsivo serif (accento viola).</p>
<form method="post" action="/admin/testi" class="form">
  <section class="card">
    <h2>Hero</h2>
    <div class="grid2">
      <label>Brand <input name="brand" value="<%= site.brand %>"></label>
      <label>Claim (etichetta sopra il titolo) <input name="claim" value="<%= site.claim %>"></label>
    </div>
    <label>Titolo <input name="hero_title" value="<%= site.hero_title %>"></label>
    <label>Tagline (una riga, usata anche dall'AI) <input name="tagline" value="<%= site.tagline %>"></label>
    <label>Testo <textarea name="hero_text" rows="4"><%= site.hero_text %></textarea></label>
    <label>"In pratica" (una riga concreta sotto il testo: cosa facciamo, con che tecnologie, dove) <textarea name="hero_concrete" rows="2"><%= site.hero_concrete || '' %></textarea></label>
    <div class="grid3">
      <label>Bottone <input name="hero_cta" value="<%= site.hero_cta %>"></label>
      <label>Immagine desktop (URL) <input name="hero_image" value="<%= site.hero_image %>"></label>
      <label>Immagine mobile (URL) <input name="hero_image_mobile" value="<%= site.hero_image_mobile %>"></label>
    </div>
  </section>
  <section class="card">
    <h2>Triade (Firmitas · Utilitas · Venustas)</h2>
    <% (site.triad || []).concat([{}, {}, {}]).slice(0, 3).forEach((t, i) => { %>
      <div class="grid3">
        <label>Latino <input name="triad[<%= i %>][la]" value="<%= t.la || '' %>"></label>
        <label>Italiano <input name="triad[<%= i %>][it]" value="<%= t.it || '' %>"></label>
        <label>Testo <input name="triad[<%= i %>][text]" value="<%= t.text || '' %>"></label>
      </div>
    <% }) %>
  </section>
  <section class="card">
    <h2>Statement (uno per riga, scorrono tra le sezioni)</h2>
    <textarea name="statements" rows="5"><%= (site.statements || []).join('\n') %></textarea>
    <label>Contesto (il mondo che cambia) <textarea name="context_text" rows="3"><%= site.context_text %></textarea></label>
  </section>
  <section class="card">
    <h2>Etichette delle aree</h2>
    <p class="muted">Come chiamare le quattro aree nel sito. Vuoto = testo standard (tra parentesi). In inglese si traducono da sole (Backoffice → Inglese).</p>
    <div class="grid2">
      <label>Voce di menu ed etichetta (Aree) <input name="areas_label" value="<%= site.areas_label || '' %>" placeholder="Aree"></label>
      <label>Titolo della sezione su desktop (Quattro sistemi, un &lt;em&gt;organismo.&lt;/em&gt;) <input name="areas_title" value="<%= site.areas_title || '' %>" placeholder="Quattro sistemi, un <em>organismo.</em>"></label>
      <label>Titolo nella Home dell'app mobile (I nostri servizi) <input name="areas_home_title" value="<%= site.areas_home_title || '' %>" placeholder="I nostri servizi"></label>
      <label>Titolo dell'elenco in Sistema, mobile (Le aree) <input name="areas_list_title" value="<%= site.areas_list_title || '' %>" placeholder="Le aree"></label>
    </div>
  </section>
  <section class="card">
    <h2>Organismo vivente</h2>
    <label>Titolo <input name="organism_title" value="<%= site.organism_title %>"></label>
    <label>Testo <textarea name="organism_text" rows="4"><%= site.organism_text %></textarea></label>
  </section>
  <section class="card">
    <h2>Team</h2>
    <label>Titolo (usa &lt;em&gt; per il corsivo) <input name="team_title" value="<%= site.team_title || '' %>"></label>
    <label>Testo <textarea name="team_text" rows="3"><%= site.team_text || '' %></textarea></label>
    <p class="muted">Le persone si gestiscono nella pagina <a href="/admin/team">Team</a>.</p>
  </section>
  <section class="card">
    <h2>Tecnologie in logica selettiva</h2>
    <label>Titolo <input name="tech_title" value="<%= site.tech_title %>"></label>
    <% (site.tech || []).concat([{}, {}, {}, {}]).slice(0, 4).forEach((t, i) => { %>
      <div class="grid2"><label>Nome <input name="tech[<%= i %>][k]" value="<%= t.k || '' %>"></label><label>Testo <input name="tech[<%= i %>][text]" value="<%= t.text || '' %>"></label></div>
    <% }) %>
  </section>
  <section class="card">
    <h2>Metodo (Mapping · Tailoring · Production · Deployment · Iteration)</h2>
    <label>Introduzione <textarea name="method_intro" rows="3"><%= site.method_intro %></textarea></label>
    <% (site.method || []).concat([{}, {}, {}, {}, {}]).slice(0, 5).forEach((t, i) => { %>
      <div class="grid2"><label>Fase <input name="method[<%= i %>][k]" value="<%= t.k || '' %>"></label><label>Testo <input name="method[<%= i %>][text]" value="<%= t.text || '' %>"></label></div>
    <% }) %>
  </section>
  <section class="card">
    <h2>Radar (sezione pubblica)</h2>
    <label>Titolo <input name="radar_title" value="<%= site.radar_title %>"></label>
    <label>Testo (spiega che sono contenuti di terzi) <textarea name="radar_text" rows="3"><%= site.radar_text %></textarea></label>
  </section>
  <section class="card">
    <h2>Chiusura e contatti</h2>
    <label>Parole di chiusura (una per riga) <textarea name="closing" rows="3"><%= (site.closing || []).join('\n') %></textarea></label>
    <label>Titolo contatti <input name="contact_title" value="<%= site.contact_title %>"></label>
    <div class="grid2"><label>Email <input name="contact_email" value="<%= site.contact_email %>"></label><label>Nota footer <input name="footer_note" value="<%= site.footer_note %>"></label></div>
    <label>Indirizzo <textarea name="contact_address" rows="2"><%= site.contact_address %></textarea></label>
    <label class="check"><input type="checkbox" name="modes_enabled" <%= site.modes_enabled ? 'checked' : '' %>> Modalità ambientali attive (tempo / umore / meteo)</label>
  </section>
  <div class="actions"><button class="btn primary" type="submit">Salva i testi</button></div>
</form>
<%- include('../partials/admin-foot') %>
