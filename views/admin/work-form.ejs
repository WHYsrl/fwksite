<%- include('../partials/admin-head', { title: isNew ? 'Nuovo lavoro' : work.client }) %>
<div class="head"><h1><%= isNew ? 'Nuovo lavoro' : work.client + ' — ' + work.title %></h1><a class="btn" href="/admin/lavori">← Lavori</a></div>
<form method="post" action="/admin/lavori/<%= isNew ? 'new' : work.id %>" enctype="multipart/form-data" class="form">
  <section class="card">
    <div class="grid3">
      <% if (isNew) { %><label>ID (slug, opzionale) <input name="id" value=""></label><% } %>
      <label>Ordine (numero; più comodo dall'elenco Lavori, con frecce e posizione) <input name="sort" type="number" value="<%= work.sort %>"></label>
      <label>Anno <input name="year" value="<%= work.year %>"></label>
      <label>Stato <select name="status"><% ['placeholder','proposta','in corso','consegnato'].forEach(s => { %><option value="<%= s %>" <%= work.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
    </div>
    <label>Priorità (quando si vede, in base al tempo scelto dal visitatore) <select name="priority"><% levels.forEach(l => { %><option value="<%= l.n %>" <%= (work.priority || 1) === l.n ? 'selected' : '' %>><%= l.label %></option><% }) %></select></label>
    <div class="grid2">
      <label>Cliente <input name="client" value="<%= work.client %>" required></label>
      <label>Etichetta breve (per la Console) <input name="label" value="<%= work.label %>" placeholder="es. Colosseo · Troia e Roma"></label>
    </div>
    <label>Titolo <input name="title" value="<%= work.title %>" required></label>
    <label>Sintesi (una riga) <input name="short" value="<%= work.short %>"></label>
    <label>Descrizione <textarea name="body" rows="6"><%= work.body %></textarea></label>
    <fieldset><legend>Aree collegate</legend><div class="checks"><% caps.forEach(c => { %><label class="check"><input type="checkbox" name="caps" value="<%= c.id %>" <%= work.caps.includes(c.id) ? 'checked' : '' %>> <%= c.name %></label><% }) %></div></fieldset>
    <div class="grid2">
      <label>Immagine (URL) <input name="image" id="w-image" value="<%= work.image %>"></label>
      <label>…oppure scegli dai media <select data-pick="#w-image" data-preview="#w-prev"><option value="">—</option><% media.forEach(m => { %><option value="<%= m.path %>"><%= m.filename %></option><% }) %></select></label>
    </div>
    <label>…oppure carica un file <input type="file" name="image_file" accept="image/*"></label>
    <img id="w-prev" class="prev" src="<%= work.image %>" alt="" <%= work.image ? '' : 'hidden' %>>
    <label>Video (link Vimeo tipo https://vimeo.com/123456789 oppure URL mp4/webm; va in loop muto nel dettaglio del lavoro) <input name="video_url" value="<%= work.video_url %>" placeholder="https://vimeo.com/…"></label>
    <label class="check"><input type="checkbox" name="published" <%= work.published ? 'checked' : '' %>> Pubblicato</label>
  </section>
  <div class="actions"><button class="btn primary" type="submit">Salva</button></div>
</form>
<% if (!isNew) { %><form method="post" action="/admin/lavori/<%= work.id %>/delete" data-confirm="Eliminare questo lavoro?"><button class="btn danger" type="submit">Elimina</button></form><% } %>
<%- include('../partials/admin-foot') %>
