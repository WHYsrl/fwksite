<%- include('../partials/admin-head', { title: sec.title }) %>
<%
// Una sezione del sito: i suoi campi (schema in server/site-fields.js). Vuoto = testo standard (mostrato come suggerimento).
const val = (k) => site[k];
const has = (v) => !(v == null || (typeof v === "string" && v.trim() === "") || (Array.isArray(v) && !v.length));
// un testo uguale allo standard conta come standard (il seed iniziale coincide con i testi standard)
const same = (v, d) => { if (!has(v) || d == null || d === "") return false; const norm = (x) => Array.isArray(x) ? JSON.stringify(x.map(r => typeof r === "object" ? Object.fromEntries(Object.entries(r).map(([k, y]) => [k, String(y || "").trim()])) : String(r).trim())) : String(x).trim(); return norm(v) === norm(d); };
const nl = (a) => (a || []).join("\n");
const idx = sections.findIndex(x => x.id === sec.id);
%>
<div class="crumbs"><a href="/admin/contenuti">Contenuti</a> <span>/</span> <b><%= String(idx + 1).padStart(2, '0') %> · <%= sec.nav %></b></div>
<div class="head sec-head">
  <div>
    <h1><%= sec.title %></h1>
    <p class="muted where"><%= sec.where %></p>
  </div>
  <div class="row">
    <% if (sec.anchor) { %><a class="btn sm" href="/<%= sec.anchor %>" target="_blank">Vedi sul sito ↗</a><% } %>
    <% (sec.manage || []).forEach(m => { %><a class="btn sm" href="<%= m.href %>"><%= m.label %> →</a><% }) %>
  </div>
</div>

<form method="post" action="/admin/contenuti/<%= sec.id %>" class="form cms">
  <section class="card fields">
  <% sec.fields.forEach((f, fi) => { %>
    <% if (!f.key) { %>
      <h3 class="fgroup"><%= f.group %></h3><% if (f.hint) { %><p class="fh fgroup-hint"><%= f.hint %></p><% } %>
    <% } else { const v = val(f.key); const custom = f.type === 'check' ? true : (has(v) && !same(v, f.from ? (resolved[f.from] || f.def) : f.def)); %>
    <div class="fld <%= custom ? 'is-custom' : 'is-default' %><%= f.optional && Array.isArray(site.hidden) && site.hidden.includes(f.key) ? ' is-off' : '' %>" data-type="<%= f.type || 'text' %>">
      <% const ph = f.from ? (resolved[f.from] || f.def || '') : (f.def || ''); const shown = !(Array.isArray(site.hidden) && site.hidden.includes(f.key)); %>
      <div class="fld-head">
        <% if (f.optional) { %><label class="show" title="Spento: l'elemento non compare sul sito"><input type="checkbox" name="show[<%= f.key %>]" value="1" <%= shown ? 'checked' : '' %>> <span>Mostra</span></label><% } %>
        <label for="f-<%= f.key %>"><%= f.label %><% if (f.em) { %> <span class="tag-em" title="Per il corsivo serif viola scrivi &lt;em&gt;parola&lt;/em&gt;">&lt;em&gt;</span><% } %></label>
        <% if (f.type !== 'check') { %><span class="fld-state"><%= custom ? 'personalizzato' : (f.from ? 'come desktop' : 'testo standard') %></span><% } %>
        <% if (custom && f.type !== 'check') { %><button type="button" class="lnk" data-reset>ripristina lo standard</button><% } %>
      </div>
      <% if (f.hint) { %><p class="fh"><%= f.hint %></p><% } %>

      <% if (f.type === 'textarea') { %>
        <textarea id="f-<%= f.key %>" name="<%= f.key %>" rows="<%= f.rows || 3 %>" placeholder="<%= f.def || '' %>"><%= custom ? v : '' %></textarea>

      <% } else if (f.type === 'lines') { %>
        <textarea id="f-<%= f.key %>" name="<%= f.key %>" rows="<%= Math.max(3, (f.def || []).length + 1) %>" placeholder="<%= nl(f.def) %>"><%= custom ? nl(v) : '' %></textarea>
        <p class="fh small">Una voce per riga.</p>

      <% } else if (f.type === 'pairs') { const rows = custom ? v : []; const n = Math.max(f.count || 0, rows.length, (f.def || []).length); %>
        <div class="pairs" style="--cols:<%= f.cols.length %>">
          <div class="pairs-h"><span></span><% f.cols.forEach(c => { %><span><%= c.label %></span><% }) %></div>
          <% for (let i = 0; i < n; i++) { const r = rows[i] || {}; const d = (f.def || [])[i] || {}; %>
          <div class="pairs-r"><span class="pairs-n"><%= i + 1 %></span><% f.cols.forEach(c => { %><input name="<%= f.key %>[<%= i %>][<%= c.k %>]" value="<%= r[c.k] || '' %>" placeholder="<%= d[c.k] || '' %>"><% }) %></div>
          <% } %>
        </div>

      <% } else if (f.type === 'image') { %>
        <div class="grid2">
          <input id="f-<%= f.key %>" name="<%= f.key %>" value="<%= custom ? v : '' %>" placeholder="<%= f.def || '' %>">
          <select data-pick="#f-<%= f.key %>" data-preview="#p-<%= f.key %>" aria-label="Scegli dai media"><option value="">…oppure scegli dai media</option><% media.forEach(m => { %><option value="<%= m.path %>"><%= m.filename %></option><% }) %></select>
        </div>
        <img id="p-<%= f.key %>" class="prev" src="<%= custom ? v : (f.def || '') %>" alt="" <%= (custom || f.def) ? '' : 'hidden' %>>

      <% } else if (f.type === 'check') { %>
        <label class="check"><input type="checkbox" name="<%= f.key %>" <%= (v == null ? !!f.def : !!v) ? 'checked' : '' %>> <%= f.on || 'Attivo' %></label>

      <% } else { %>
        <input id="f-<%= f.key %>" name="<%= f.key %>" value="<%= custom ? v : '' %>" placeholder="<%= ph %>">
      <% } %>

      <% if (custom && (f.from || f.def) && f.type !== 'check' && f.type !== 'image' && f.type !== 'pairs') { %><p class="fh def"><%= f.from ? 'Come desktop sarebbe' : 'Standard' %>: <span><%= f.from ? ph : (Array.isArray(f.def) ? f.def.join(' · ') : f.def) %></span></p><% } %>
    </div>
    <% } %>
  <% }) %>
  </section>

  <div class="savebar">
    <span class="muted">Vuoto = testo standard. «Mostra» spento = l'elemento non compare. In inglese i testi personalizzati si traducono da soli (<a href="/admin/inglese">Inglese</a>).</span>
    <button class="btn primary" type="submit">Salva · <%= sec.nav %></button>
  </div>
</form>

<div class="sec-nav">
  <% if (prev) { %><a class="btn" href="/admin/contenuti/<%= prev.id %>">← <%= prev.nav %></a><% } else { %><span></span><% } %>
  <% if (next) { %><a class="btn" href="/admin/contenuti/<%= next.id %>"><%= next.nav %> →</a><% } %>
</div>
<%- include('../partials/admin-foot') %>
