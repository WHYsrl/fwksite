<%
/* L'Organismo — pagina a sé (schermo intero): phone=false è lo schermo principale (utile per proiettori e demo),
   phone=true è il secondo schermo aperto dal QR (stanza `room`). Il blocco vero è nel partial, lo stesso usato nel sito. */
const brand = (site && site.brand) || "Frameworks";
%><!doctype html>
<html lang="it" class="vo-page <%= phone ? "vo-phone" : "vo-desk" %>" data-mood="vivid" data-energy="auto" data-weather="unknown" data-density="all">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,maximum-scale=1,user-scalable=no">
<meta name="robots" content="noindex">
<title>L'Organismo · <%= brand %></title>
<meta name="theme-color" content="#050307">
<link rel="preload" href="/public/fonts/HelveticaNowDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/public/css/site.css?v=<%= typeof v !== 'undefined' ? v : '1' %>">
<link rel="stylesheet" href="/public/css/organismo.css?v=<%= typeof v !== 'undefined' ? v : '1' %>">
<link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/public/apple-touch-icon.png">
</head>
<body class="vo-body">
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="fw-mark" viewBox="0 0 51.09 59"><g fill="currentColor"><polygon points="51.09 14.75 25.55 59 51.09 44.25 51.09 14.75"/><polygon points="25.55 29.5 0 14.75 25.55 0 51.09 14.75 25.55 29.5"/><polygon points="25.55 29.5 25.55 59 0 44.25 25.55 29.5"/></g></symbol>
</svg>
<div class="grain" aria-hidden="true"></div>

<%- include("partials/organismo", { mode: phone ? "phone" : "desktop", room: room || "", standalone: true }) %>

<header class="vo-top">
  <a class="vo-logo" href="/" aria-label="<%= brand %>"><svg viewBox="0 0 51.09 59" width="18" height="21" aria-hidden="true"><use href="#fw-mark"/></svg><span><%= brand %></span></a>
  <span class="eyebrow vo-eyebrow"><span class="dot"></span><%= phone ? "Secondo schermo" : "L'organismo" %></span>
  <% if (!phone) { %>
  <div class="vo-mood" role="group" aria-label="Di che umore sei?">
    <span class="k">Di che umore sei?</span>
    <div class="seg"><button type="button" data-mood="vivid">Acceso</button><button type="button" data-mood="calm">Notturno</button><button type="button" data-mood="nervous">Quieto</button><button type="button" data-mood="light">Chiaro</button></div>
  </div>
  <% } %>
</header>

<script src="/public/js/vendor/qrcode.js"></script>
<script src="/public/js/organismo.js?v=<%= typeof v !== 'undefined' ? v : '1' %>"></script>
</body>
</html>
