</main>
</div>
</div>
<script>
document.querySelectorAll('[data-confirm]').forEach(f=>f.addEventListener('submit',e=>{ if(!confirm(f.dataset.confirm)) e.preventDefault(); }));
document.querySelectorAll('[data-reset]').forEach(b=>b.addEventListener('click',()=>{ const f=b.closest('.fld'); f.querySelectorAll('input:not([type=checkbox]),textarea').forEach(i=>{ i.value=''; }); f.classList.remove('is-custom'); f.classList.add('is-default'); const st=f.querySelector('.fld-state'); if(st) st.textContent='testo standard (dopo il salvataggio)'; b.remove(); }));
document.querySelectorAll('[data-move]').forEach(b=>b.addEventListener('click',()=>{ const tr=b.closest('tr'); const tb=tr.parentElement; const dir=+b.dataset.move; const sib=dir<0?tr.previousElementSibling:tr.nextElementSibling; if(!sib||sib.dataset.fixed) return; if(dir<0) tb.insertBefore(tr,sib); else tb.insertBefore(sib,tr); const inp=tb.closest('form').querySelector('input[name="'+tb.dataset.order+'"]'); if(inp) inp.value=[...tb.querySelectorAll('tr[data-id]')].map(r=>r.dataset.id).join(','); tr.classList.add('moved'); setTimeout(()=>tr.classList.remove('moved'),600); }));
document.querySelectorAll('.fld-head .show input').forEach(c=>c.addEventListener('change',()=>{ c.closest('.fld').classList.toggle('is-off', !c.checked); }));
document.querySelectorAll('[data-pick]').forEach(sel=>sel.addEventListener('change',()=>{ const t=document.querySelector(sel.dataset.pick); if(t){ t.value=sel.value; const p=document.querySelector(sel.dataset.preview); if(p){ const isV=/\.(mp4|webm|mov)(\?|$)/i.test(sel.value); if(p.tagName==='IMG'){ p.src=isV?'':sel.value; p.hidden=!sel.value||isV; } } } }));
// menu (desktop e mobile): righe che si spostano, si tolgono, si aggiungono; i nomi dei campi si rinumerano così l'ordine salvato è quello che si vede
(function(){
  const renum=(tb)=>{ [...tb.querySelectorAll('tr.menu-row')].forEach((r,i)=>{ r.querySelectorAll('[name]').forEach(el=>{ el.name=el.name.replace(/\[\d+\]/,'['+i+']'); }); }); };
  const sync=(sel)=>{ const r=sel.closest('tr'); const std=JSON.parse(sel.dataset.std||'{}'), icons=JSON.parse(sel.dataset.icons||'{}'); const v=sel.value; const url=r.querySelector('.menu-url'); if(url) url.hidden=v!=='url'; r.querySelectorAll('.menu-blank').forEach(b=>b.hidden=v!=='url'); const lab=r.querySelector('.menu-label'); if(lab){ lab.disabled=v==='lang'; lab.placeholder=v==='lang'?'IT / EN (automatico)':(std[v]?'Standard: '+std[v]:''); } const ic=r.querySelector('.menu-icon'); if(ic&&icons[v]&&!ic.dataset.touched) ic.value=icons[v]; };
  document.addEventListener('change',e=>{ const s=e.target.closest('.menu-target'); if(s) sync(s); const ic=e.target.closest('.menu-icon'); if(ic) ic.dataset.touched='1'; });
  document.addEventListener('click',e=>{
    const mv=e.target.closest('[data-menu-move]'); if(mv){ const r=mv.closest('tr'); const tb=r.parentElement; const dir=+mv.dataset.menuMove; const sib=dir<0?r.previousElementSibling:r.nextElementSibling; if(!sib) return; if(dir<0) tb.insertBefore(r,sib); else tb.insertBefore(sib,r); renum(tb); return; }
    const del=e.target.closest('[data-menu-del]'); if(del){ const r=del.closest('tr'); const tb=r.parentElement; r.remove(); renum(tb); return; }
    const add=e.target.closest('[data-menu-add]'); if(add){ const key=add.dataset.menuAdd; const tb=document.querySelector('[data-menu-rows="'+key+'"]'); const tpl=document.querySelector('[data-menu-template="'+key+'"]'); if(!tb||!tpl) return; tb.appendChild(tpl.content.cloneNode(true)); renum(tb); const last=tb.querySelector('tr:last-child .menu-target'); if(last) sync(last); last && last.closest('tr').querySelector('.menu-label').focus(); return; }
  });
})();
// galleria di un lavoro: le frecce spostano la riga; i nomi dei campi vengono rinumerati così l'ordine salvato è quello che si vede
document.querySelectorAll('[data-gal-move]').forEach(b=>b.addEventListener('click',()=>{ const row=b.closest('.gal-row'); const box=row.parentElement; const dir=+b.dataset.galMove; const sib=dir<0?row.previousElementSibling:row.nextElementSibling; if(!sib) return; if(dir<0) box.insertBefore(row,sib); else box.insertBefore(sib,row); [...box.children].forEach((r,i)=>{ r.querySelector('.pairs-n').textContent=String(i+1).padStart(2,'0'); r.querySelectorAll('input,select,img,span[id]').forEach(el=>{ if(el.name) el.name=el.name.replace(/gallery\[\d+\]/,'gallery['+i+']'); if(el.id&&/^gp?-\d+$/.test(el.id)) el.id=el.id.replace(/\d+$/,String(i)); if(el.dataset.pick) el.dataset.pick='#g-'+i; if(el.dataset.preview) el.dataset.preview='#gp-'+i; }); }); }));
document.querySelectorAll('.gal-row input[id^=g-]').forEach(inp=>inp.addEventListener('input',()=>{ const p=document.getElementById(inp.id.replace('g-','gp-')); if(p&&p.tagName==='IMG'){ p.src=inp.value; p.hidden=!inp.value||/vimeo\.com\/|\.(mp4|webm|mov)(\?|$)/i.test(inp.value); } }));
// l'immagine di un caso d'uso scritta a mano aggiorna l'anteprima
document.querySelectorAll('.use-row input[id^=ui-]').forEach(inp=>inp.addEventListener('input',()=>{ const p=document.getElementById(inp.id.replace('ui-','up-')); if(p){ p.src=inp.value; p.hidden=!inp.value; } }));
</script>
</body>
</html>
