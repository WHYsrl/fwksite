<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Frameworks Backoffice</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/public/css/admin.css?v=<%= typeof v !== "undefined" ? v : "1" %>">
</head>
<body>
<%
// Il backoffice è organizzato come un CMS: a sinistra i gruppi (Contenuti del sito, Collezioni, Radar, Console, Sistema),
// a destra la pagina. Sotto "Contenuti" compaiono le sezioni del sito, nell'ordine in cui si vedono sul sito.
const on = (p) => (p === "/" ? path === "/" : path.startsWith(p));
const GROUPS = [
  { name: "Sito", items: [{ href: "/admin", p: "/", label: "Panoramica" }, { href: "/admin/contenuti", p: "/contenuti", label: "Contenuti", sub: true }, { href: "/admin/fruizione", p: "/fruizione", label: "Fruizione" }] },
  { name: "Collezioni", items: [{ href: "/admin/capacita", p: "/capacita", label: "Aree (servizi)" }, { href: "/admin/lavori", p: "/lavori", label: "Lavori" }, { href: "/admin/reel", p: "/reel", label: "Reel" }, { href: "/admin/team", p: "/team", label: "Team" }] },
  { name: "Radar", items: [{ href: "/admin/radar", p: "/radar", label: "Segnali" }, { href: "/admin/fonti", p: "/fonti", label: "Fonti e filtri" }] },
  { name: "Console e AI", items: [{ href: "/admin/contesto", p: "/contesto", label: "Contesto della Console" }, { href: "/admin/dati", p: "/dati", label: "Dati del contesto" }, { href: "/admin/ai", p: "/ai", label: "AI", warn: !aiOn }] },
  { name: "Sistema", items: [{ href: "/admin/media", p: "/media", label: "Media" }, { href: "/admin/inglese", p: "/inglese", label: "Inglese" }] }
];
const curSec = (typeof sec !== "undefined" && sec) ? sec.id : "";
%>
