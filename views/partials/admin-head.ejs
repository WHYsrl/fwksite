  <nav class="as-nav">
    <% GROUPS.forEach(g => { %>
    <div class="as-group"><div class="as-gname"><%= g.name %></div>
      <% g.items.forEach(it => { %>
      <a href="<%= it.href %>" class="<%= on(it.p) ? 'on' : '' %>"><%= it.label %><% if (it.warn) { %><i class="warn" title="chiave API mancante"></i><% } %></a>
      <% if (it.sub && on(it.p) && typeof sections !== "undefined") { %>
      <ol class="as-sub"><% sections.forEach((sc, i) => { %><li><a href="/admin/contenuti/<%= sc.id %>" class="<%= sc.id === curSec ? 'on' : '' %>"><i><%= String(i + 1).padStart(2, '0') %></i><%= sc.nav %></a></li><% }) %></ol>
      <% } %>
      <% }) %>
    </div>
    <% }) %>
  </nav>
  <div class="as-foot"><a href="/" target="_blank">Vedi il sito ↗</a><form method="post" action="/admin/logout"><button type="submit">Esci</button></form></div>
</aside>
<div class="page">
<% if (flash) { %><div class="flash <%= flash.kind %>"><%= flash.msg %></div><% } %>
<main class="am">
