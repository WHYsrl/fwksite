# Copia questo file in .env e compila i valori.
PORT=3000
# Cartella dei dati (database SQLite + upload). Su Render: /var/data (disco persistente)
DATA_DIR=./data
# Accesso al backoffice /admin
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-questa-password
# Firma dei cookie di sessione (stringa lunga e casuale)
SESSION_SECRET=cambia-questa-stringa-lunga-e-casuale
# AI: basta una delle due chiavi. Il provider attivo si sceglie anche da /admin/ai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Radar automatico (off per disattivare il giro periodico)
RADAR_SCHEDULE=on
NODE_ENV=development
